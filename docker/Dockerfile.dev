# ../docker/Dockerfile.dev
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

ARG UID=1000
ARG UNAME=builduser
ARG GROUP_GID=1000
ARG UGNAME=buildgroup

# --- System deps (keep lean but compatible with common Python wheels) ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      curl \
      ca-certificates \
      git \
      procps \
      build-essential \
      gnupg \
      # Common headers for pip builds (cryptography/lxml/etc)
      libssl-dev \
      zlib1g-dev \
      libbz2-dev \
      libreadline-dev \
      libsqlite3-dev \
      libncursesw6 \
      xz-utils \
      libxml2-dev \
      libxmlsec1-dev \
      libffi-dev \
      liblzma-dev && \
    rm -rf /var/lib/apt/lists/*

# --- Create user/group (matches devcontainer args) ---
RUN groupadd -g ${GROUP_GID} ${UGNAME} && \
    useradd -m -u ${UID} -g ${UGNAME} -s /bin/bash ${UNAME} && \
    usermod -aG sudo ${UNAME} && \
    echo "${UNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${UNAME} && \
    chmod 0440 /etc/sudoers.d/${UNAME}

# --- Node.js 22 ---
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    npm cache clean --force

# --- Python tooling ---
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir pipx virtualenv

# --- Verify toolchain ---
RUN node -v && npm -v && python --version && pip --version && git --version

# --- IMPORTANT: create workspace at /home/builduser/APP ---
RUN mkdir -p /home/${UNAME}/APP /home/${UNAME}/.local/bin && \
    chown -R ${UNAME}:${UGNAME} /home/${UNAME}

# Switch to non-root
USER ${UNAME}

# ✅ Work directly in /home/builduser/APP
WORKDIR /home/${UNAME}/APP

ENV PATH="/home/${UNAME}/.local/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

CMD ["/bin/bash"]
