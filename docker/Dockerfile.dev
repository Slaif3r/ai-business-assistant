FROM mcr.microsoft.com/devcontainers/python:3.11

# Optional: install OS deps your project needs
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    curl \
    ca-certificates \
    git \
    build-essential \
  && rm -rf /var/lib/apt/lists/*

# If you want node pinned in Dockerfile (instead of feature), you can,
# but in Dev Containers it's cleaner to use the node feature.

WORKDIR /workspaces
