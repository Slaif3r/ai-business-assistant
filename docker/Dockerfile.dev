FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

ARG UID=20001
ARG UNAME=builduser
ARG GROUP_GID=10001
ARG UGNAME=buildgroup

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      curl \
      ca-certificates \
      git \
      procps \
      build-essential \
      python3 \
      python3-venv \
      python3-pip \
      python3-dev \
      libssl3 \
      zlib1g \
      libbz2-1.0 \
      libreadline8 \
      libsqlite3-0 \
      libncursesw6 \
      xz-utils \
      libxml2 \
      libxmlsec1 \
      libffi8 \
      liblzma5 && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_GID} ${UGNAME} && \
    useradd -m -u ${UID} -g ${UGNAME} -s /bin/bash ${UNAME} && \
    usermod -aG sudo ${UNAME} && \
    echo "${UNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${UNAME} && \
    chmod 0440 /etc/sudoers.d/${UNAME}

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    npm cache clean --force

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1 && \
    python -m pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir pipx virtualenv

RUN node -v && npm -v && python --version && pip --version && git --version

RUN mkdir -p /home/${UNAME}/APP && chown -R ${UNAME}:${UGNAME} /home/${UNAME}/APP

USER ${UNAME}
WORKDIR /home/${UNAME}

ENV PATH="/home/${UNAME}/.local/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

CMD ["/bin/bash"]