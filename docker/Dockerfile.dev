FROM mcr.microsoft.com/devcontainers/python:1-3.11-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Remove Yarn apt source lists if present (prevents NO_PUBKEY yarnpkg.com failures)
RUN rm -f /etc/apt/sources.list.d/yarn.list \
          /etc/apt/sources.list.d/yarn*.list \
          /etc/apt/sources.list.d/*yarn* || true

# Minimal packages that commonly prevent remote tooling breakage (Antigravity/SSH/CLI tooling)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    wget \
    procps \
    build-essential \
    ca-certificates \
    curl \
    git \
    openssh-client \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Workspace (Codespaces standard)
WORKDIR /workspaces/ai-business-assistant

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
