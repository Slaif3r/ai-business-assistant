{
  "name": "AI Business Assistant - Antigravity Dev",

  "build": {
    "dockerfile": "../docker/Dockerfile.dev",
    "context": "..",
    "args": {
      "UID": "1000",
      "GROUP_GID": "1000",
      "UNAME": "builduser",
      "UGNAME": "buildgroup"
    }
  },

  "remoteUser": "builduser",
  "containerUser": "builduser",
  "updateRemoteUserUID": true,

  "workspaceFolder": "/home/builduser/APP",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/builduser/APP,type=bind,consistency=cached",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "builduser",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "eamodio.gitlens",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "ms-python.isort",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "usernamehw.errorlens",
        "oderwat.indent-rainbow",
        "PKief.material-icon-theme"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.terminal.activateEnvironment": true,
        "python.linting.enabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },

        "jupyter.askForKernelRestart": false,
        "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],

        "editor.formatOnSave": true,
        "editor.rulers": [88, 120],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordWrap": "on",
        "editor.minimap.enabled": true,
        "editor.suggestSelection": "first",
        "editor.bracketPairColorization.enabled": true,

        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash", "icon": "terminal-bash" },
          "zsh": { "path": "/bin/zsh", "icon": "terminal" }
        },

        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/*.pyc": true,
          "**/.DS_Store": true
        },
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/**": true,
          "**/__pycache__/**": true
        },

        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,

        "[markdown]": {
          "editor.defaultFormatter": "yzhang.markdown-all-in-one",
          "editor.wordWrap": "on"
        }
      }
    }
  },

  "forwardPorts": [8000, 8080, 8888, 5000],

  "postCreateCommand": "bash -c 'python -m pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi'",

  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/builduser/.ssh,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/builduser/.gitconfig,type=bind,consistency=cached,readonly"
  ],

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },

  "runArgs": [
    "--name=ai-business-assistant-dev",
    "--hostname=ai-business-assistant"
  ],

  "initializeCommand": "echo 'Initializing devcontainer...'",
  "onCreateCommand": "echo 'Container created successfully!'",
  "updateContentCommand": "echo 'Updating container content...'",
  "postStartCommand": "git config --global --add safe.directory /home/builduser/APP"
}
